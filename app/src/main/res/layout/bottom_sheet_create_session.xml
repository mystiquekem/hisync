<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/divider"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New Session"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="20dp"/>

    <!-- Lineup picker -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LINEUP"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="6dp"/>

    <Spinner
        android:id="@+id/spinnerLineup"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_card"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="12dp"/>

    <!-- Date + Time picker -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DATE &amp; TIME"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickDateTime"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Pick date &amp; time"
        android:textColor="@color/text_primary"
        app:strokeColor="@color/divider"
        app:cornerRadius="8dp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvSessionDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/purple_primary"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:visibility="gone"/>

    <!-- Duration picker -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DURATION"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="6dp"/>

    <Spinner
        android:id="@+id/spinnerDuration"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_card"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateSession"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Create Session"
        android:textColor="@color/white"
        app:backgroundTint="@color/purple_primary"
        app:cornerRadius="12dp"/>

</LinearLayout>