<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <!-- ── HEADER CARD (terracotta) ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#D4603A">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Music note background decoration -->
                    <com.example.hisync.MusicNoteView
                        android:id="@+id/musicNoteHeader"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.12"/>

                    <!-- Top row: avatar + name + role -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvAvatar"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#3D2000"
                            android:background="@drawable/bg_avatar_amber"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvUserName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#F5EDDB"/>

                            <TextView
                                android:id="@+id/tvBandName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="#F5EDDB"
                                android:alpha="0.75"
                                android:text="—"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvRoleBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#7A2E10"
                            android:background="@drawable/bg_badge_cream"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Member"/>

                    </LinearLayout>

                    <!-- Next session inner card -->
                    <LinearLayout
                        android:id="@+id/cardNextSession"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_session_inner"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎸"
                            android:textSize="22sp"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NEXT SESSION"
                                android:textSize="9sp"
                                android:letterSpacing="0.12"
                                android:textColor="#F5EDDB"
                                android:alpha="0.65"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvSessionSong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#F5EDDB"
                                android:maxLines="1"
                                android:ellipsize="end"/>

                            <TextView
                                android:id="@+id/tvSessionDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textColor="#F5EDDB"
                                android:alpha="0.7"/>

                        </LinearLayout>

                        <!-- Days countdown chip -->
                        <LinearLayout
                            android:id="@+id/layoutCountdown"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_amber_chip"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvDaysCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#3D2000"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAYS"
                                android:textSize="7sp"
                                android:textStyle="bold"
                                android:textColor="#5C3A00"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Empty session state -->
                    <TextView
                        android:id="@+id/tvEmptySession"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No upcoming sessions"
                        android:textSize="13sp"
                        android:textColor="#F5EDDB"
                        android:alpha="0.6"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="@drawable/bg_session_inner"
                        android:visibility="gone"/>

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── STATS CARD (teal) ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#3A9BAD">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvStatSessions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#F5EDDB"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SESSIONS"
                            android:textSize="9sp"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:textColor="#E1F5F8"
                            android:alpha="0.75"/>

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:background="#4DFFFFFF"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvStatTasks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#F5EDDB"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TASKS"
                            android:textSize="9sp"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:textColor="#E1F5F8"
                            android:alpha="0.75"/>

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:background="#4DFFFFFF"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvStatMembers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#F5EDDB"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MEMBERS"
                            android:textSize="9sp"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:textColor="#E1F5F8"
                            android:alpha="0.75"/>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── BAND PROGRESS CARD (cream) ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F5EDDB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯"
                            android:textSize="16sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BAND PROGRESS"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="#7A2E10"/>

                        <TextView
                            android:id="@+id/tvProgressLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/0 tasks"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#D4603A"/>

                    </LinearLayout>

                    <!-- Progress bar background -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_progress_track"
                        android:layout_marginBottom="6dp">

                        <View
                            android:id="@+id/viewProgressFill"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_progress_fill"/>

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvProgressEncourage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keep it up! 🔥"
                        android:textSize="11sp"
                        android:textColor="#A0602A"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── MY TASKS SECTION ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MY TASKS"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:textColor="@color/text_tertiary"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <!-- Empty state A: no tasks at all -->
            <LinearLayout
                android:id="@+id/layoutEmptyNoTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/bg_card_accent"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyNoTasksEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎵"
                    android:textSize="40sp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tvEmptyNoTasksMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvEmptyNoTasksSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- Empty state B: all tasks approved -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutEmptyAllDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F5EDDB">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.example.hisync.MusicNoteView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.08"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎉"
                            android:textSize="40sp"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Everything's clear!"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#7A2E10"
                            android:gravity="center"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvAllDoneSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#A0602A"
                            android:gravity="center"
                            android:layout_marginBottom="16dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEmptyAction"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="View Schedule"
                            android:textColor="#F5EDDB"
                            android:paddingHorizontal="20dp"
                            app:backgroundTint="#D4603A"
                            app:cornerRadius="20dp"/>

                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/layoutTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

