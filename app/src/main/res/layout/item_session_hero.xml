<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_session_hero"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeroTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#FADBD5"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="17sp"
                android:textColor="@color/white"
                android:maxLines="2"
                android:ellipsize="end"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvHeroBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="11sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_pill_translucent"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/heroAvatarStack"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:orientation="horizontal"/>

        <TextView
            android:id="@+id/tvHeroLineup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="#FADBD5"/>

    </LinearLayout>

</LinearLayout>
